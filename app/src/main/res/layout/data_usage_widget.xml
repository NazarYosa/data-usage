<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- Top Header: Last Update Time & Refresh Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/widget_last_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="00:00:00"
            android:textColor="@color/widget_unit_text"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/widget_update"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="3dp"
            android:src="@drawable/ic_refresh" />

        <ProgressBar
            android:id="@+id/widget_update_progress"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="3dp"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Row 1: Mobile Data (Data di atas) -->
    <RelativeLayout
        android:id="@+id/layout_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/icon_mobile_data"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_round_mobile_data" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/container_mobile_value"
            android:layout_toEndOf="@+id/icon_mobile_data"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mobile_data_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_mobile_data"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_data_usage_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_remaining_placeholder"
                android:textColor="@color/widget_unit_text"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Right: Bold Number + Unit -->
        <LinearLayout
            android:id="@+id/container_mobile_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_mobile_data_used"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"
                android:textColor="@color/widget_val_mobile"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_mobile_data_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="2dp"
                android:text="GB"
                android:textColor="@color/widget_unit_text"
                android:textSize="13sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Divider Line: MUST BE ImageView, NOT View! (RemoteViews rejects View class) -->
    <ImageView
        android:id="@+id/divider_widget"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/widget_divider" />

    <!-- Row 2: Wi-Fi (Wi-Fi di bawah) -->
    <RelativeLayout
        android:id="@+id/layout_wifi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/icon_wifi"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_round_wifi" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/container_wifi_value"
            android:layout_toEndOf="@+id/icon_wifi"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wifi_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_wifi"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right: Bold Number + Unit -->
        <LinearLayout
            android:id="@+id/container_wifi_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_wifi_used"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"
                android:textColor="@color/widget_val_wifi"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_wifi_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="2dp"
                android:text="GB"
                android:textColor="@color/widget_unit_text"
                android:textSize="13sp" />
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>
